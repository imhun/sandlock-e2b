# Secrets — change in production.
E2B_API_KEYS=local-key
E2B_INTERNAL_API_KEY=internal-key

# Port exposed on the host (API + gateway share this port).
CONTROL_PLANE_PORT=3000

# Gateway route cache TTL (seconds). Default 30; the gateway re-resolves and
# retries once on a failed/502 upstream, so this only bounds lookups.
E2B_GATEWAY_ROUTE_TTL=30

# Template image distribution. Leave the registry fields empty for
# single-host behavior. For a local HTTP registry (the optional `registry`
# service), set e.g. E2B_IMAGE_REGISTRY=127.0.0.1:5000/e2b and add
# 127.0.0.1:5000 to the Docker daemon's insecure-registries.
E2B_IMAGE_REGISTRY=
E2B_IMAGE_REGISTRY_USERNAME=
E2B_IMAGE_REGISTRY_PASSWORD=

# Base image for the `base` template.
E2B_BASE_IMAGE=python:3.11-slim

# Resource limits (0 disables a dimension).
E2B_MAX_SANDBOXES=100
E2B_MAX_TOTAL_MEMORY_MB=8192
E2B_MAX_TOTAL_CPU_PERCENT=400
E2B_MAX_TOTAL_DISK_MB=10240
E2B_MAX_TOTAL_PROCESSES=2048

# Per-worker capacity.
E2B_NODE_MEMORY_MB=2048
E2B_NODE_CPU_PERCENT=200
E2B_NODE_DISK_MB=4096
E2B_NODE_PROCESSES=256

# Image tags used by docker-compose.prod.yml (prebuilt images or :latest).
# Image name = service, tag = version (e2b-sandlock-{service}:{version})
CONTROL_PLANE_IMAGE=registry.cn-shanghai.aliyuncs.com/byteplan/e2b-sandlock-control-plane:0.1.0
WORKER_IMAGE=registry.cn-shanghai.aliyuncs.com/byteplan/e2b-sandlock-worker:0.1.0
