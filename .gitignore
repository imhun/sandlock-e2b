__pycache__/
*.pyc
.pytest_cache/
tmp_pytest/
tmp/
wheels/fork/
deploy/stack/.env
deploy/stack/.version
deploy/stack/tls/
# The compose stacks' *instance* env, same rule as `deploy/stack/.env` above.
# Every `deploy/**/*.env.example` is a tracked template; the file you get by
# copying it holds the operator's values (ports and image tags today, and the
# first credential key somebody adds tomorrow). Documented commands do
# `cp .../.env.example .../.env`, so the instance files all have to be ignored
# -- being born untracked is not something to rely on, since the next
# `git add -A` does not ask. `tests/unit/test_deploy_env_examples_are_ignored.py`
# pins the symmetry rather than this list.
deploy/compose/.env
deploy/compose/tls/
deploy/scripts/bastion.env
deploy/scripts/acr.env
tests/sdk/js/node_modules/
tests/sdk/js/package-lock.json
.DS_Store

envd_service/egress/*.so
.patchloom/backups/
.superpowers/

# graphify's generated graph (cache + html + report); the *config* that shapes it
# (`.graphifyignore`) is committed, the 47M of output it produces is not.
graphify-out/
# A cargo build directory that only ever means anything inside the dev container:
# it is a symlink to `/src/target-linux`. Committing it would be committing a
# dangling link (see docs/build-test-deploy-pitfalls.md A2).
/target
# The same build directory under the name the fork's `target` symlink uses
# (`third_party/sandlock/target -> /src/target-linux`), i.e. the dev container's
# cargo output. 5.8 GB after a test run, and never source.
/target-linux/
