FROM python:3.14-slim

RUN sed -i \
        's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    docker-cli \
    iptables \
    gcc \
    libc6-dev \
    iproute2 \
    redis-server \
    bash \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
COPY requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r /tmp/requirements-test.txt

# The sandlock Python test suite (and the sandboxes it spawns) exec the
# system interpreter at /usr/bin/python3; the python:3.14-slim image installs
# it under /usr/local, so expose the conventional path.
RUN ln -sf /usr/local/bin/python3 /usr/bin/python3

# sandlock fork wheel (Block A/B/C) — see Dockerfile.envd for the mapping;
# the pick is scoped to the image's own CPython ABI + TARGETARCH.
ARG TARGETARCH
COPY wheels/fork/ /tmp/wheels/
RUN PY_ABI=$(python3 -c 'import sys; print(f"cp{sys.version_info.major}{sys.version_info.minor}")') \
    && ARCH_SUFFIX=$(case "$TARGETARCH" in \
        amd64) echo x86_64 ;; \
        arm64) echo aarch64 ;; \
        *) echo "$TARGETARCH" ;; \
    esac) \
    && SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-manylinux*${ARCH_SUFFIX}.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-linux_${ARCH_SUFFIX}.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-*.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/*.whl | head -1) \
    && pip install --no-cache-dir "$SANLOCK_WHL" \
    && rm -rf /tmp/wheels

WORKDIR /workspace

COPY envd_service/mcp/gateway.py /usr/bin/mcp-gateway
RUN chmod +x /usr/bin/mcp-gateway \
    && ln -sf /usr/bin/mcp-gateway /usr/local/bin/mcp-gateway

CMD ["pytest", "tests/unit", "tests/contract"]
