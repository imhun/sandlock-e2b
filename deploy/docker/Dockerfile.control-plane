# Control plane final image: API + registry + scheduler only.
# The worker (Dockerfile.envd) runs sandboxes; this image never does.
FROM python:3.14-slim

WORKDIR /app

RUN sed -i \
        's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

COPY gateway_common/ gateway_common/
COPY control_plane/ control_plane/
# The worker fleet's autoscaler is hosted by this app (k8s path, 2026-09-30):
# the loop, its policy and the Kubernetes backend are imported at startup by
# `control_plane.app`, so the package ships with the control plane. It adds no
# dependency -- `autoscaler.backends.k8s` speaks the API with httpx.
COPY autoscaler/ autoscaler/

ENV E2B_WORKSPACE_BASE=/var/lib/e2b-sandboxes
EXPOSE 3000

CMD ["python", "-m", "control_plane"]
