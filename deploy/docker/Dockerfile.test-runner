FROM moby/buildkit:latest AS buildkit

FROM python:3.14-slim

RUN sed -i \
        's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    docker-cli \
    iptables \
    gcc \
    libc6-dev \
    iproute2 \
    redis-server \
    bash \
    git \
    curl \
    xfsprogs \
    e2fsprogs \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
COPY requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r /tmp/requirements-test.txt

# The sandlock Python test suite (and the sandboxes it spawns) exec the
# system interpreter at /usr/bin/python3; the python:3.14-slim image installs
# it under /usr/local, so expose the conventional path.
RUN ln -sf /usr/local/bin/python3 /usr/bin/python3

# sandlock fork wheel (Block A/B/C) — see Dockerfile.envd for the mapping;
# wheels/fork/ is gitignored build output: run
# ./scripts/build-sandlock-wheels.sh before building this image;
# the pick is scoped to the image's own CPython ABI + TARGETARCH.
ARG TARGETARCH
COPY wheels/fork/ /tmp/wheels/
RUN PY_ABI=$(python3 -c 'import sys; print(f"cp{sys.version_info.major}{sys.version_info.minor}")') \
    && ARCH_SUFFIX=$(case "$TARGETARCH" in \
        amd64) echo x86_64 ;; \
        arm64) echo aarch64 ;; \
        *) echo "$TARGETARCH" ;; \
    esac) \
    && SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-manylinux*${ARCH_SUFFIX}.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-linux_${ARCH_SUFFIX}.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-*.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/*.whl | head -1) \
    && pip install --no-cache-dir "$SANLOCK_WHL" \
    && rm -rf /tmp/wheels

# buildctl is what ``Template.build`` drives: the buildkitd test fixture starts
# a rootless buildkit daemon container, and the control plane in this image
# speaks to it with this client (same source as Dockerfile.control-plane-gateway).
COPY --from=buildkit /usr/bin/buildctl /usr/bin/buildctl

# Public images must not be pulled straight from Docker Hub: anonymous pulls
# hit 429 TOOMANYREQUESTS long before a test session is over, and that shows up
# as sandbox-create failures. Look them up through domestic mirrors first (the
# origin stays as the last endpoint, so a dead mirror cannot break a pull).
# Same mirror the buildkitd config already uses for image builds.
ENV E2B_REGISTRY_MIRRORS="registry-1.docker.io=docker.m.daocloud.io|docker.1ms.run"

# Test scratch space has to be container-native storage. /workspace is a bind
# mount of the host repo (virtiofs on an OrbStack/Docker Desktop host), where
# chown is a no-op, so the per-sandbox uid tests would assert against a
# filesystem that cannot express ownership at all.
ENV E2B_TEST_TMP_ROOT=/var/lib/e2b-test-runtime
# The scratch root is created as root (0755) but the *unprivileged* lane
# (`test-prod-shaped.sh` phase 2) runs the whole suite as uid 65534 and cannot
# create anything under it, so every fixture that needs a workspace errored out
# at setup: `PermissionError: /var/lib/e2b-test-runtime/<id>` (measured
# 2026-09-17: 503 setup errors, 24 failures, and the same on the unmodified
# image, i.e. phase 2 was unrunnable, not merely red). Hand the directory to
# the same uid the phase-2 container runs as -- the worker image does the same
# for /var/lib/e2b-sandboxes.
RUN mkdir -p /var/lib/e2b-test-runtime \
    && chown 65534:65534 /var/lib/e2b-test-runtime

WORKDIR /workspace

COPY envd_service/mcp/gateway.py /usr/bin/mcp-gateway
RUN chmod +x /usr/bin/mcp-gateway \
    && ln -sf /usr/bin/mcp-gateway /usr/local/bin/mcp-gateway

# The official JS SDK job installs from a domestic registry (no dependency on
# the public npm registry being reachable from the runner).
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Run the shapes that used to be opt-in: sandboxes execute inside an image
# rootfs (the production worker shape) and the per-sandbox netns/fd-injection
# contract suite runs too. Both were previously invisible because the default
# run left them gated off, and the strict gate below forbids that.
ENV E2B_BASE_IMAGE=python:3.11-slim \
    E2B_TEST_NET_ISOLATION=1

# A gate this runner can satisfy must not skip: an unsatisfied gate fails the
# run loudly instead of quietly dropping coverage (see tests/conftest.py).
ENV E2B_TEST_STRICT_SKIPS=1

# Loop-mounts XFS with prjquota (and puts the sandbox workspaces on it) before
# handing over to pytest, so the quota/ownership tests run for real.
COPY deploy/docker/entrypoint.test-runner.sh /usr/local/bin/entrypoint.test-runner.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.test-runner.sh"]

# Track F (Task F1): the same two file-capability brokers the worker image
# ships (see Dockerfile.envd for why they are compiled, why `setcap` has to run
# in this stage, and why the directory is root-owned group 65534 mode 0710).
# They are here so the unprivileged phase of deploy/scripts/test-prod-shaped.sh
# -- uid 65534 with the four declared caps -- exercises the real non-root
# shape instead of proving that file capabilities are unusable.
COPY deploy/priv/ /tmp/priv/
RUN cc -O2 -Wall -Wextra -o /tmp/priv/e2b-slot-spawn \
        /tmp/priv/slot_spawn.c /tmp/priv/priv_common.c \
    && cc -O2 -Wall -Wextra -o /tmp/priv/e2b-maint \
        /tmp/priv/maint.c /tmp/priv/priv_common.c \
    && apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/e2b-priv \
    && chown root:65534 /var/lib/e2b-priv \
    && chmod 0710 /var/lib/e2b-priv \
    && install -m 0750 -o root -g 65534 \
        /tmp/priv/e2b-slot-spawn /tmp/priv/e2b-maint /var/lib/e2b-priv/ \
    && setcap cap_setuid,cap_setgid+ep /var/lib/e2b-priv/e2b-slot-spawn \
    && setcap cap_chown,cap_dac_override+ep /var/lib/e2b-priv/e2b-maint \
    && rm -rf /tmp/priv \
    && getcap /var/lib/e2b-priv/e2b-slot-spawn /var/lib/e2b-priv/e2b-maint

CMD ["pytest", "tests/unit", "tests/contract"]
