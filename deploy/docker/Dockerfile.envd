# Worker final image: envd service + Sandlock executor + egress proxy lib.
# The control plane never runs here; the runtime C compiler is only needed
# in the builder stage (the egress library ships prebuilt per platform).
FROM python:3.14-slim AS builder

RUN sed -i \
        's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

COPY envd_service/egress/ /tmp/egress/
RUN cc -shared -fPIC -O2 -Wall -o /tmp/egress/libegress_proxy.so \
        /tmp/egress/libegress_proxy.c -ldl

# Track F (Task F1): the two file-capability brokers. They have to be *compiled*
# binaries -- file capabilities do not work on `#!` scripts -- and they are
# copied into the FINAL stage, which is the only place `setcap` may run:
# `COPY --from` does not carry the security.capability xattr, so applying the
# caps here would silently produce unprivileged helpers.
COPY deploy/priv/ /tmp/priv/
RUN cc -O2 -Wall -Wextra -o /tmp/priv/e2b-slot-spawn \
        /tmp/priv/slot_spawn.c /tmp/priv/priv_common.c \
    && cc -O2 -Wall -Wextra -o /tmp/priv/e2b-maint \
        /tmp/priv/maint.c /tmp/priv/priv_common.c

FROM python:3.14-slim

WORKDIR /app

RUN sed -i \
        's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends bash \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

# sandlock fork wheel (Block A/B/C: wildcard allowOut, header inject,
# host mask, SOCKS5 egress on-behalf). wheels/fork/ is gitignored build
# output (run ./scripts/build-sandlock-wheels.sh first; fork source lives in
# the third_party/sandlock submodule); holds per-arch wheels;
# the pick is scoped to the image's own CPython ABI + TARGETARCH so future
# cp-matrix wheels in the same dir cannot be selected by accident.
ARG TARGETARCH
COPY wheels/fork/ /tmp/wheels/
RUN PY_ABI=$(python3 -c 'import sys; print(f"cp{sys.version_info.major}{sys.version_info.minor}")') \
    && ARCH_SUFFIX=$(case "$TARGETARCH" in \
        amd64) echo x86_64 ;; \
        arm64) echo aarch64 ;; \
        *) echo "$TARGETARCH" ;; \
    esac) \
    && SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-manylinux*${ARCH_SUFFIX}.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-linux_${ARCH_SUFFIX}.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/sandlock-*-${PY_ABI}-${PY_ABI}-*.whl 2>/dev/null | head -1) \
    && [ -n "$SANLOCK_WHL" ] || SANLOCK_WHL=$(ls /tmp/wheels/*.whl | head -1) \
    && pip install --no-cache-dir "$SANLOCK_WHL" \
    && rm -rf /tmp/wheels

COPY gateway_common/ gateway_common/
COPY envd_service/ envd_service/

# Prebuilt egress proxy library (platform-matched by the image arch).
COPY --from=builder /tmp/egress/libegress_proxy.so /opt/egress/libegress_proxy.so

RUN cp envd_service/mcp/gateway.py /usr/bin/mcp-gateway \
    && chmod +x /usr/bin/mcp-gateway \
    && ln -sf /usr/bin/mcp-gateway /usr/local/bin/mcp-gateway

# E5.1: the worker/supervisor must not run as root (escape amplification:
# a sandbox that fully bypasses Landlock/seccomp would get container root).
# sandlock officially supports uid 65534 with no privileged capabilities
# (S1.3). The workspace base and the per-worker image cache directory are
# created up front and owned by 65534; the named volume initialized from
# this image inherits that ownership, so no root-side chown is needed on a
# fresh deployment.
ENV E2B_WORKSPACE_BASE=/var/lib/e2b-sandboxes

# Track F (Task F1): install the brokers at a path a sandbox can never reach --
# /var/lib/e2b-priv, root-owned with the worker's gid (65534) and mode 0710,
# binaries 0750. DAC, not Landlock, is the barrier: a sandbox uid is a pooled
# uid (10000+) and never in group 65534, so it can neither traverse the
# directory nor exec the binaries, which also keeps the guarantee in the pure
# shape. (A plain root-owned 0700 directory is unexecutable by the *worker*
# too; measured in tmp/f1/f1-stage1.log.) Deliberately not /usr/local or /opt:
# the pure shape's Landlock rules cover those prefixes.
#
# `libcap2-bin` is installed here for `setcap` -- the build container itself
# needs CAP_SETFCAP -- and is kept because the container lane verifies the
# result with `getcap`. No runtime code path needs the package or the
# capability: whoever can exec these files is exactly who holds the
# capability (docs/production-deployment-requirements.md §2.4.1).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/e2b-priv \
    && chown root:65534 /var/lib/e2b-priv \
    && chmod 0710 /var/lib/e2b-priv
COPY --from=builder /tmp/priv/e2b-slot-spawn /tmp/priv/e2b-maint /var/lib/e2b-priv/
RUN chown root:65534 /var/lib/e2b-priv/e2b-slot-spawn /var/lib/e2b-priv/e2b-maint \
    && chmod 0750 /var/lib/e2b-priv/e2b-slot-spawn /var/lib/e2b-priv/e2b-maint \
    && setcap cap_setuid,cap_setgid+ep /var/lib/e2b-priv/e2b-slot-spawn \
    && setcap cap_chown,cap_dac_override+ep /var/lib/e2b-priv/e2b-maint \
    && getcap /var/lib/e2b-priv/e2b-slot-spawn /var/lib/e2b-priv/e2b-maint

RUN mkdir -p /var/lib/e2b-sandboxes /app/tmp/sandboxes \
    && chown -R 65534:65534 /var/lib/e2b-sandboxes /app/tmp
VOLUME /var/lib/e2b-sandboxes
USER 65534:65534
EXPOSE 49983

CMD ["python", "-m", "envd_service"]
