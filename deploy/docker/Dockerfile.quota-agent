# quota-agent: NFS server-side XFS project quota manager (E2.6).
#
# Runs on the NFS server host where the shared XFS filesystem lives (or next
# to it with the filesystem bind-mounted) and executes xfs_quota locally on
# behalf of workers that only see the NFS client mount.
#
# The service itself is the top-level `quota_agent/` package (moved out of
# `deploy/` on 2026-09-30: `deploy/` holds deployment configuration and
# scripts, and this is a service with its own image, like `control_plane/`,
# `c3_agent/` and `autoscaler/`). The `COPY` below used to be `deploy/`, which
# dragged the whole manifest/script tree into the image for one package.
#
# The XFS filesystem must be mounted with prjquota + projid32bit. When the
# container mounts the filesystem itself (loop device / direct device), run
# it privileged with the device attached; when the host already mounts it,
# bind-mount the directory instead (no privileged needed).
#
# e2fsprogs is for lsattr: orphan reconciliation maps a projid back to its
# directory with `lsattr -p -d` (envd_service/xfs_quota.py::_scan_project_dirs).
# Without it a non-empty orphan project can only be reported, never cleaned.
FROM python:3.14-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    xfsprogs \
    e2fsprogs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

COPY gateway_common/ gateway_common/
COPY envd_service/ envd_service/
COPY quota_agent/ quota_agent/

ENV E2B_QUOTA_AGENT_HOST=0.0.0.0
ENV E2B_QUOTA_AGENT_PORT=49984
EXPOSE 49984

CMD ["python", "-m", "quota_agent"]
