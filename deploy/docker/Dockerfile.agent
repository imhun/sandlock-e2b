# C3 (Task 1): the per-node agent's **own** image -- two file-capability
# binaries and nothing else.
#
# Why a second image instead of reusing the worker's (deploy/docker/Dockerfile.envd):
# the plan's judgement #2 is that the *worker* image must not contain the
# privileged binaries at all ("0 privileged binaries", P3/Task 4). That is only
# an assertable property if the agent's copy lives somewhere the worker image
# never builds from -- a shared image would make "worker image has no
# /var/lib/e2b-priv" a statement about a build arg instead of about a file. The
# old reason to share the image was that the socket protocol was the two sides'
# contract; under C3 there is no `worker <-> agent` channel at all (hard rule
# 5), so that reason is gone.
#
# Two binaries, two faces, two owners:
#
#   /var/lib/e2b-priv/as_uid     face A: `cap_setuid,cap_setgid+ep`, runs as
#                                65534. Writes the identity map of a pid the
#                                worker just unshared (`c3_agent/priv/as_uid.c`;
#                                the capability is what lets it name an id at
#                                all, the 65534 is what makes the *target's*
#                                namespace accept the write -- §14.2.7).
#   /var/lib/e2b-priv/e2b-maint  face B: `cap_chown,cap_dac_override+ep`. The
#                                same broker C1 shipped (`c3_agent/priv/maint.c`),
#                                moved to the agent's file face -- deliberately
#                                unchanged, capability for capability.
#
# `c3_agent/priv/` (moved out of `deploy/` on 2026-09-30) is C source and not a
# deployment asset; it sits next to its only production consumer. Its one other
# consumer is the test-runner image (`deploy/docker/Dockerfile.test-runner`),
# which compiles the retired-socket half -- `deploy/` holds configuration and
# scripts, so neither copy belongs there.
#
# The directory is `0710 root:<agent gid>`, the binaries `0750`, exactly as
# `docs/c3-privilege-relocation.md` §2 records: DAC (not Landlock) is the
# barrier, and a sandbox uid is a pooled uid that is never in this group.
#
# Face B runs as uid 0 (NFS AUTH_SYS only honours uid 0 for `chown`), which the
# DaemonSet sets per container (`runAsUser: 0` + `drop: [ALL]` +
# `add: [CHOWN, DAC_OVERRIDE, FOWNER]`). This image's own `USER` is face A's,
# because a container that forgets to override it must end up unprivileged, not
# root. `no-new-privileges` must stay **off**: NNP=1 makes the kernel ignore
# file capabilities, and both faces would fail silently.
FROM python:3.14-slim AS builder

RUN sed -i \
        's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

COPY c3_agent/priv/ /tmp/priv/
RUN cc -O2 -Wall -Wextra -o /tmp/priv/as_uid \
        /tmp/priv/as_uid.c /tmp/priv/priv_common.c \
    && cc -O2 -Wall -Wextra -o /tmp/priv/e2b-maint \
        /tmp/priv/maint.c /tmp/priv/priv_common.c

# A slim Debian base, for the same reasons every other Dockerfile here uses
# one: it already carries `ca-certificates`, which the mirror's https sources
# need before anything can be installed. Nothing of the *sandbox* runtime --
# no envd_service, no gateway_common, no egress library, no sandlock wheel --
# is copied in: the two lines below are this image's whole privileged payload.
FROM python:3.14-slim

RUN sed -i \
        's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/e2b-priv \
    && chown root:65534 /var/lib/e2b-priv \
    && chmod 0710 /var/lib/e2b-priv

# The binaries are copied into the FINAL stage and capped *here*: a
# `COPY --from` does not carry the `security.capability` xattr, so applying the
# caps in the builder would ship two unprivileged helpers that look installed.
# `libcap2-bin` stays (the same call the worker image makes): the lane verifies
# the result with `getcap`, and nothing on any runtime path needs the package.
COPY --from=builder /tmp/priv/as_uid /tmp/priv/e2b-maint /var/lib/e2b-priv/
RUN chown root:65534 /var/lib/e2b-priv/as_uid /var/lib/e2b-priv/e2b-maint \
    && chmod 0750 /var/lib/e2b-priv/as_uid /var/lib/e2b-priv/e2b-maint \
    && setcap cap_setuid,cap_setgid+ep /var/lib/e2b-priv/as_uid \
    && setcap cap_chown,cap_dac_override+ep /var/lib/e2b-priv/e2b-maint \
    && getcap /var/lib/e2b-priv/as_uid /var/lib/e2b-priv/e2b-maint

# Task 2: the control-plane channel. The agent's service is a small FastAPI app
# (`c3_agent/`, a top-level package next to `control_plane/` and `autoscaler/`:
# it is a service of its own, not a deployment asset) -- the CP→agent half of
# C3's two channels (there is no worker↔agent channel). Only what that service
# imports comes in: the pinned web stack, `gateway_common.env` (one integer
# reader) and `c3_agent` itself. Still deliberately *not* the sandbox runtime:
# no envd_service, no sandlock wheel, no egress library.
#
# `httpx` is part of that stack and not decoration: Task 6's inventory scan
# (`c3_agent/scan.py`, imported by `app.py` unconditionally) uses it to
# report to the control plane. Measured 2026-09-29 on this tree: without it the
# image does not even *import* (`ModuleNotFoundError: No module named 'httpx'`
# at `app.py` line 105), so the service crash-loops and every grant refuses.
WORKDIR /app

RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
        fastapi==0.141.1 \
        'uvicorn[standard]==0.52.4' \
        httpx==0.28.1 \
        pydantic==2.13.5

COPY c3_agent/ /app/c3_agent/
COPY gateway_common/ /app/gateway_common/

# Face A's identity. The agent DaemonSet overrides it per container (face B is
# root by manifest, `runAsUser: 0`); the default has to be the unprivileged one.
USER 65534:65534

# Face A serves the control-plane channel; face B's file ops are a later task.
# The service refuses to start without `E2B_C3_AGENT_TOKEN` and its own node id
# (`c3_agent/__main__.py`), so an accidentally exposed port is inert.
CMD ["python3", "-m", "c3_agent"]
