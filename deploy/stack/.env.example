# Deploy/upgrade configuration for the sandlock stack.
# Copy to .env and fill in; upgrade.sh auto-generates secrets on first deploy
# and preserves remote secrets on later upgrades.

# Secrets (auto-generated on first deploy; keep stable across upgrades)
E2B_API_KEYS=__E2B_API_KEYS__
E2B_INTERNAL_API_KEY=__E2B_INTERNAL_API_KEY__

# Host port exposed (API + gateway share this port; E2B_SANDBOX_URL uses the same)
CONTROL_PLANE_PORT=3000

# Gateway route cache TTL (seconds). Default 30; multi-replica deployments
# may lower it to tighten stale-route windows (the gateway also re-resolves
# and retries once on a failed/502 upstream).
E2B_GATEWAY_ROUTE_TTL=30

# buildkitd endpoint for Template.build (default matches the compose service)
E2B_BUILDKIT_ADDR=tcp://buildkit:1234

# Images from ACR. Naming: image name = service, tag = version
# (upgrade.sh rewrites the tags to the last built VERSION recorded in
# deploy/stack/.version; override with --version / VERSION=).
# control-plane-gateway runs the control plane API (:3000) AND the envd
# gateway (:49983) in one service.
CONTROL_PLANE_IMAGE=registry.cn-shanghai.aliyuncs.com/byteplan/e2b-sandlock-control-plane-gateway:0.1.0
WORKER_IMAGE=registry.cn-shanghai.aliyuncs.com/byteplan/e2b-sandlock-worker:0.1.0

# ACR credentials used by workers to pull the sandbox base image directly.
# Template builds push to this registry; workers pull from it (Docker Hub
# is unreachable from the target, so local-only images would not resolve).
E2B_IMAGE_REGISTRY=registry.cn-shanghai.aliyuncs.com/byteplan
E2B_IMAGE_REGISTRY_USERNAME=__ACR_USERNAME__
E2B_IMAGE_REGISTRY_PASSWORD=__ACR_PASSWORD__

# Base image for sandboxes; must be reachable from the target (mirrored to
# ACR by build-and-push.sh since Docker Hub is blocked there). The MCP-capable
# image ships mcp + uvicorn + mcp-gateway for Sandbox.create(mcp=...).
E2B_BASE_IMAGE=registry.cn-shanghai.aliyuncs.com/byteplan/python-mcp:3.14

# Template ID -> base image (reachable from the target; Docker Hub is not).
E2B_TEMPLATE_IMAGES={"py311": "registry.cn-shanghai.aliyuncs.com/byteplan/python:3.11-slim"}

# Resource limits tuned for 4C / 7.3G
E2B_MAX_SANDBOXES=100
E2B_MAX_TOTAL_MEMORY_MB=5120
E2B_MAX_TOTAL_CPU_PERCENT=400
E2B_MAX_TOTAL_DISK_MB=10240
E2B_MAX_TOTAL_PROCESSES=1024

# Per-worker capacity
E2B_NODE_MEMORY_MB=2048
E2B_NODE_CPU_PERCENT=200
E2B_NODE_DISK_MB=4096
E2B_NODE_PROCESSES=256
