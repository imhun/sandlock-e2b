        <mxCell id="title" value="系统架构 · sandlock-e2b" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#f9fafb;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="五层结构：客户端 → 接入 → 控制面 → 数据面（worker 与沙箱）→ 特权面；底部是共享存储与宿主 kernel" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry" />
        </mxCell>

        <!-- ================= 客户端与接入 ================= -->
        <mxCell id="lane_client" value="客户端与接入" style="swimlane;startSize=28;horizontal=1;rounded=0;html=1;container=1;collapsible=0;fillColor=#111827;swimlaneFillColor=#111827;strokeColor=#4b5563;fontColor=#9ca3af;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="300" height="190" as="geometry" />
        </mxCell>

        <mxCell id="n_sdk" value="&lt;b&gt;e2b SDK&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#9ca3af'&gt;Python 2.46.0 / JS 2.46.1 · 零代码修改&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#374151;strokeColor=#6b7280;fontColor=#f3f4f6;fontSize=13;" vertex="1" parent="lane_client">
