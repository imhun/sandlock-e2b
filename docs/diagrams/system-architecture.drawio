  <diagram name="系统架构">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
