        <mxCell id="n_faceB" value="&lt;b&gt;面 B · maint :49986 · root&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#fecaca'&gt;chown / rm / walk · 五根路径白名单&lt;br&gt;节点上唯一的 root 组件&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#ef4444;strokeWidth=2;fontColor=#ffffff;fontSize=13;" vertex="1" parent="lane_agent">
