        </mxCell>

        <mxCell id="n_ingress" value="&lt;b&gt;前置 ingress / SLB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#fed7aa'&gt;TLS 终止 · 不在本仓库内（见 R5）&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#f97316;fontColor=#ffedd5;fontSize=13;" vertex="1" parent="lane_client">
          <mxGeometry x="20" y="115" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- ================= 控制面 ================= -->
        <mxCell id="lane_cp" value="控制面 · control-plane（Deployment ×2 · uid 65534）" style="swimlane;startSize=28;horizontal=1;rounded=0;html=1;container=1;collapsible=0;fillColor=#14532d;swimlaneFillColor=#14532d;strokeColor=#22c55e;fontColor=#86efac;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="600" height="190" as="geometry" />
        </mxCell>

        <mxCell id="n_cp" value="&lt;b&gt;control-plane + gateway :3000&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#bbf7d0'&gt;Sandbox REST API · 调度 / TTL / 配额账本&lt;br&gt;按 E2b-Sandbox-Id 透传 · autoscaler 循环&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#22c55e;strokeWidth=2;fontColor=#ffffff;fontSize=14;" vertex="1" parent="lane_cp">
          <mxGeometry x="20" y="45" width="310" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n_redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#a7f3d0'&gt;注册表 / 配额账本&lt;br&gt;--requirepass&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#22c55e;fontColor=#ffffff;fontSize=13;" vertex="1" parent="lane_cp">
          <mxGeometry x="380" y="45" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- ================= 数据面 worker ================= -->
        <mxCell id="lane_worker" value="数据面 · e2b-worker pod（uid 65534 · cap drop ALL · 无 hostPID）" style="swimlane;startSize=28;horizontal=1;rounded=0;html=1;container=1;collapsible=0;fillColor=#1f2937;swimlaneFillColor=#1f2937;strokeColor=#22c55e;fontColor=#86efac;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="540" height="440" as="geometry" />
        </mxCell>

        <mxCell id="n_envd" value="&lt;b&gt;envd_service :49983&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#a7f3d0'&gt;沙箱生命周期 · 文件 · 命令&lt;br&gt;X-Access-Token fail-closed&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#22c55e;fontColor=#ffffff;fontSize=13;" vertex="1" parent="lane_worker">
          <mxGeometry x="20" y="50" width="260" height="85" as="geometry" />
        </mxCell>

        <mxCell id="n_sup" value="&lt;b&gt;supervisor（中介层）&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#a7f3d0'&gt;路径翻译 · /proc 合成 · netlink 虚拟 · 代执行&lt;br&gt;持 seccomp notify fd&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#22c55e;fontColor=#ffffff;fontSize=13;" vertex="1" parent="lane_worker">
          <mxGeometry x="20" y="150" width="260" height="85" as="geometry" />
        </mxCell>

        <mxCell id="n_sbx" value="&lt;b&gt;沙箱进程（租户代码 · 不可信）&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#bfdbfe'&gt;userns + pidns + netns · uid 池内独占&lt;br&gt;Landlock 白名单 + seccomp 内层&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#3b82f6;strokeWidth=3;fontColor=#ffffff;fontSize=14;" vertex="1" parent="lane_worker">
          <mxGeometry x="20" y="250" width="260" height="95" as="geometry" />
        </mxCell>

        <mxCell id="n_b2" value="&lt;b&gt;外层 seccomp profile（B-2）&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color=#fde68a'&gt;SCMP_ACT_ERRNO + 416 条&lt;br&gt;唯一通到宿主的一道 · 是配置不是代码&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=13;" vertex="1" parent="lane_worker">
