<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="安全防护">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="安全防护 · 三段判定链" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#f9fafb;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="判定链上任何一层被单独打穿，上面还有别的" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="800" height="20" as="geometry" />
        </mxCell>

        <mxCell id="banner" value="&lt;b&gt;威胁模型&lt;/b&gt;：攻击者&lt;b&gt;已经在沙箱内拿到任意代码执行&lt;/b&gt; —— 下面每一段挡的都是这个前提之后的攻击。A 类挡不住这个前提之前的事，所以它只是准入。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c1917;strokeColor=#57534e;fontColor=#e7e5e4;fontSize=11;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1140" height="38" as="geometry" />
        </mxCell>

        <mxCell id="GA" value="A · 入口 —— 还没进沙箱" style="swimlane;startSize=28;horizontal=1;rounded=0;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#0f1f2e;swimlaneFillColor=#0f1f2e;strokeColor=#60a5fa;strokeWidth=2;fontColor=#93c5fd;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="136" width="250" height="230" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="&lt;b&gt;L1 准入&lt;/b&gt; · control-plane&lt;br&gt;&lt;font style='font-size:10px;color:#93c5fd'&gt;API key · 配额 · 记账 → 401 / 429&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#60a5fa;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GA">
          <mxGeometry x="12" y="38" width="226" height="56" as="geometry" />
        </mxCell>

        <mxCell id="L2" value="&lt;b&gt;L2 令牌&lt;/b&gt; · envd 两半守卫&lt;br&gt;&lt;font style='font-size:10px;color=#93c5fd'&gt;runtime token · fail-closed → 拒绝&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#60a5fa;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GA">
          <mxGeometry x="12" y="100" width="226" height="56" as="geometry" />
        </mxCell>

        <mxCell id="Ahole" value="&lt;b&gt;缺口&lt;/b&gt; · 只认证不授权租户&lt;br&gt;&lt;font style='font-size:10px;color=#fcd34d'&gt;一个 API key 管所有沙箱&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1c1917;strokeColor=#f59e0b;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GA">
          <mxGeometry x="12" y="162" width="226" height="56" as="geometry" />
        </mxCell>

        <mxCell id="GB1" value="B-1 · 遏制 —— 沙箱代码（fork + envd）" style="swimlane;startSize=28;horizontal=1;rounded=0;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#0f1f2e;swimlaneFillColor=#0f1f2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#93c5fd;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="136" width="310" height="230" as="geometry" />
        </mxCell>

        <mxCell id="L3" value="&lt;b&gt;L3 seccomp 内层&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#93c5fd'&gt;按名字 76 + 按参数 4 处 → &lt;b&gt;EPERM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;漏：6.13 的 *at 族 15 个&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#3b82f6;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GB1">
          <mxGeometry x="12" y="38" width="286" height="56" as="geometry" />
        </mxCell>

        <mxCell id="L4" value="&lt;b&gt;L4 Landlock&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#93c5fd'&gt;路径 + 设备 ioctl · strict_all → &lt;b&gt;EACCES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;漏：普通文件上的 ioctl 不归它管&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#3b82f6;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GB1">
          <mxGeometry x="12" y="100" width="286" height="56" as="geometry" />
        </mxCell>

        <mxCell id="L5" value="&lt;b&gt;L5 中介层&lt;/b&gt; · supervisor&lt;br&gt;&lt;font style='font-size:10px;color=#93c5fd'&gt;路径翻译 / 合成 / 代执行 → &lt;b&gt;EAFNOSUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;漏：不在翻译表里的带路径 syscall&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#3b82f6;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GB1">
          <mxGeometry x="12" y="162" width="286" height="56" as="geometry" />
        </mxCell>

        <mxCell id="GB2" value="B-2 · 遏制 —— 部署配置" style="swimlane;startSize=28;horizontal=1;rounded=0;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#2a1d0b;swimlaneFillColor=#2a1d0b;strokeColor=#f59e0b;strokeWidth=4;fontColor=#fde68a;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="136" width="250" height="230" as="geometry" />
        </mxCell>

        <mxCell id="L6" value="&lt;b&gt;L6 外层 profile&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#fcd34d'&gt;SCMP_ACT_ERRNO + 416 条 → &lt;b&gt;ENOSYS(38)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;兜住内层没登记的面&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#f59e0b;strokeWidth=3;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GB2">
          <mxGeometry x="12" y="38" width="226" height="56" as="geometry" />
        </mxCell>

        <mxCell id="B2kind" value="&lt;b&gt;不是代码，是一份 JSON&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#fcd34d'&gt;判定链上唯一通到宿主的段&lt;br&gt;却没有任何自动化门禁&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1c1917;strokeColor=#f59e0b;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GB2">
          <mxGeometry x="12" y="100" width="226" height="56" as="geometry" />
        </mxCell>

        <mxCell id="B2drift" value="&lt;b&gt;失效是静默的&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;换运行时 / 合并 Docker 默认档 / 置空变量&lt;br&gt;— 三种都让文件与生效值脱钩&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1c1917;strokeColor=#f59e0b;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GB2">
          <mxGeometry x="12" y="162" width="226" height="56" as="geometry" />
        </mxCell>

        <mxCell id="a_host" value="&lt;b&gt;宿主机&lt;/b&gt;&lt;br&gt;&lt;b&gt;kernel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#d6d3d1'&gt;共用内核&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0c0a09;strokeColor=#a8a29e;strokeWidth=6;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1030" y="196" width="150" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ar1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=9;strokeColor=#22c55e;strokeWidth=2;" edge="1" parent="1" source="GA" target="GB1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ar2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=11;strokeColor=#f59e0b;strokeWidth=4;" edge="1" parent="1" source="GB1" target="GB2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ar3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=13;strokeColor=#ef4444;strokeWidth=6;" edge="1" parent="1" source="GB2" target="a_host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="capA" value="打穿 = 拿到一个沙箱" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#93c5fd;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="372" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="capB1" value="全穿只到 worker 容器" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#86efac;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="372" width="310" height="24" as="geometry" />
        </mxCell>
        <mxCell id="capB2" value="打穿才到宿主" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#fde68a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="372" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="capHost" value="提权成功后容器加固一律无效" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#9ca3af;" vertex="1" parent="1">
          <mxGeometry x="1010" y="312" width="190" height="20" as="geometry" />
        </mxCell>

        <mxCell id="GC" value="C · 隔离 —— 沙箱能碰到谁（不进判定链：管的是爆炸半径，不是提权）" style="swimlane;startSize=28;horizontal=1;rounded=0;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#0f1f2e;swimlaneFillColor=#0f1f2e;strokeColor=#a78bfa;strokeWidth=2;dashed=1;fontColor=#c4b5fd;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="416" width="560" height="228" as="geometry" />
        </mxCell>

        <mxCell id="C1" value="&lt;b&gt;网络策略&lt;/b&gt; · worker ↔ c3-agent&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;agent 的 ingress 只放 &lt;b&gt;app: control-plane&lt;/b&gt; → worker 来敲在连接层就被挡&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#a78bfa;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GC">
          <mxGeometry x="12" y="38" width="536" height="56" as="geometry" />
        </mxCell>

        <mxCell id="C2" value="&lt;b&gt;每沙箱 uid + DAC&lt;/b&gt; · 沙箱 ↔ 沙箱&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;0770 且沙箱 gid ≠ worker gid ⇒ Landlock 被绕过也还有第二道墙&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#a78bfa;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GC">
          <mxGeometry x="12" y="100" width="536" height="56" as="geometry" />
        </mxCell>

        <mxCell id="C3" value="&lt;b&gt;per-sandbox netns&lt;/b&gt; · 入站 / 回环&lt;br&gt;&lt;font style='font-size:10px;color=#fcd34d'&gt;⚠ 不管出站 —— 代执行在 worker netns 建连，出站目的地完全由 CIDR 规则决定&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#a78bfa;fontColor=#e5e7eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="GC">
          <mxGeometry x="12" y="162" width="536" height="56" as="geometry" />
        </mxCell>

        <mxCell id="PRISK" value="三处最薄的地方 · 每处的查法不同" style="swimlane;startSize=28;horizontal=1;rounded=0;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#111827;swimlaneFillColor=#111827;strokeColor=#4b5563;fontColor=#e5e7eb;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="416" width="560" height="228" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="&lt;b&gt;① c3-agent —— 单点依赖&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;hostPID（pod 级，两容器都拿到）· 无 seccomp · 节点唯一 root · 网络面只有一条策略&lt;br&gt;&lt;b&gt;挡的是「沙箱够不到 agent」，不是「agent 够不到沙箱」&lt;/b&gt; → 查法：读那条策略&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2a1215;strokeColor=#ef4444;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="PRISK">
          <mxGeometry x="12" y="38" width="536" height="56" as="geometry" />
        </mxCell>

        <mxCell id="R2" value="&lt;b&gt;② B-2 —— 配置即防线，失效是静默的&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;换运行时 / 合并 Docker 内置档 / 显式置空变量 —— 读文件看不出生效值&lt;br&gt;&lt;b&gt;这条只能靠差分实验&lt;/b&gt;，不能靠 review diff&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2a1d0b;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="PRISK">
          <mxGeometry x="12" y="100" width="536" height="56" as="geometry" />
        </mxCell>

        <mxCell id="R3" value="&lt;b&gt;③ 共享内核 —— 够不到&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color=#9ca3af'&gt;CVE-2026-53362（KEV 在列）：arm64「不可利用」&lt;b&gt;是架构运气，不是设计安全&lt;/b&gt;&lt;br&gt;查法：触发它的 syscall 有没有落在沙箱能看见的地方&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c1917;strokeColor=#a8a29e;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="PRISK">
          <mxGeometry x="12" y="162" width="536" height="56" as="geometry" />
        </mxCell>

        <mxCell id="footnote" value="「漏」不是待修的 bug，是设计里预留的冗余 —— 删掉一份 deny 之前，先得论证另一份还在。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#9ca3af;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="654" width="1140" height="24" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
