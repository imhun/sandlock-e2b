# Autoscaler: polls the control plane and grows/retires the worker pool
# (local Docker pool manager or Kubernetes Deployment).
FROM python:3.14-slim

WORKDIR /app

RUN sed -i \
        's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    # docker CLI manages the local worker pool through the host socket.
    && apt-get install -y --no-install-recommends docker.io docker-cli \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

COPY autoscaler/ autoscaler/

CMD ["python", "-m", "autoscaler"]
